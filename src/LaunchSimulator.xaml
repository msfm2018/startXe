<Window x:Class="WpfApp1.LaunchSimulator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
     Title="启动模拟器" Height="200" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Border Background="#FAFAFA" Padding="20" BorderThickness="1" BorderBrush="#DDD" CornerRadius="8">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <WrapPanel>
                <Image x:Name="IconImage" Width="64" Height="64" Margin="0,0,20,0"/>
                <StackPanel>
                    <TextBlock x:Name="PathText" TextWrapping="Wrap" FontSize="14" Margin="0,5,0,5"/>
                    <TextBlock x:Name="TooltipText" FontSize="13" Foreground="Gray"/>
                </StackPanel>
            </WrapPanel> 
            <Button Content="关闭" Width="100" Height="30" Margin="0,20,0,0" HorizontalAlignment="Right" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
